#!/usr/bin/env sh
# Lanzador local de r-name. Todo queda en esta carpeta (binario y datos).
set -eu

DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="$DIR/dist/r-name-linux-x86_64"
LOG="$DIR/.cargo-build.log"
FLAG="$DIR/.cargo-ready"

# Colores (tput si está disponible, fallback a escapes octales POSIX)
if command -v tput >/dev/null 2>&1; then
    GREEN="$(tput setaf 2)"
    BOLD="$(tput bold)"
    RESET="$(tput sgr0)"
else
    GREEN="\033[32m"
    BOLD="\033[1m"
    RESET="\033[0m"
fi

if [ ! -x "$BIN" ]; then
    echo "· compilando (solo la primera vez)…"
    rm -f "$FLAG" "$LOG"

    # Compilar en segundo plano; salida completa oculta en un log
    (
        cd "$DIR" && cargo build --release >"$LOG" 2>&1
        touch "$FLAG"
    ) &
    CARGO_PID=$!

    # Loader circular animado mientras compila
    SPIN="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    i=0
    while kill -0 "$CARGO_PID" 2>/dev/null; do
        pos=$((i + 1))
        ch=$(printf '%s' "$SPIN" | cut -c"$pos")
        printf "\r%s%s Compilando r-name...%s" "$BOLD$GREEN" "$ch" "$RESET"
        i=$(( (i + 1) % 10 ))
        sleep 0.1
    done

    status=0
    wait "$CARGO_PID" || status=$?

    if [ "$status" -ne 0 ]; then
        printf "\r\x1b[K\n"
        echo "Error al compilar. Revisa el log: $LOG"
        exit "$status"
    fi

    printf "\r\x1b[K%s%s✔ Compilado con éxito.%s\n" "$BOLD$GREEN" "" "$RESET"

    mkdir -p "$DIR/dist"
    cp "$DIR/target/release/r-name" "$BIN"
fi

R_NAME_HOME="$DIR"
export R_NAME_HOME
cd "$DIR"
exec "$BIN" "$@"
