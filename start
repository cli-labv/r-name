#!/usr/bin/env sh
# Lanzador local de renamr. Todo queda en esta carpeta (binario y datos).
set -eu

DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="$DIR/dist/renamr-linux-x86_64"

if [ ! -x "$BIN" ]; then
    echo "· compilando (solo la primera vez)…"
    ( cd "$DIR" && cargo build --release )
    mkdir -p "$DIR/dist"
    cp "$DIR/target/release/renamr" "$BIN"
fi

RENAMR_HOME="$DIR"
export RENAMR_HOME
cd "$DIR"
exec "$BIN" "$@"
