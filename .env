# Variables de entorno para renamr modo directo (./start --t)
# Título de la serie. Si se deja vacío, se usa el nombre de la carpeta superior
# que agrupa a las temporadas (ej. re zero).
RENAMR_TITLE=

# Orden de renombrado de los episodios dentro de cada temporada:
# name, name-desc, created-desc, modified-asc, modified-desc
RENAMR_SORT=modified-asc
